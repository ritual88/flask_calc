# Задай эти переменные локально или в разделе Environment настроек Render.
# Не вставляй реальные пароли и ключи в этот файл и не коммить их.
FLASK_SECRET_KEY=generate-a-long-random-secret
OWNER_PASSWORD=choose-a-long-unique-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev
OWNER_EMAIL=owner@example.com
EMAIL_TEST_MODE=true
